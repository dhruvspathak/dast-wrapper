APP_NAME=DAST Orchestration Platform
ENVIRONMENT=production
API_CORS_ORIGINS=

# Host ports exposed by nginx only.
HTTP_PORT=80
HTTPS_PORT=443

# Database
POSTGRES_DB=dast_wrapper
POSTGRES_USER=dast_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://dast_user:change-me@postgres:5432/dast_wrapper

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_SCAN_QUEUE=scan
CELERY_REPLAY_QUEUE=replay
CELERY_VALIDATION_QUEUE=validation
CELERY_REPORT_QUEUE=report
WORKER_CONCURRENCY=2

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=

# ZAP
ZAP_API_URL=http://zap:8080
ZAP_JAVA_OPTS=-Xms512m -Xmx1536m
ZAP_SCAN_TIMEOUT_SECONDS=1800
ZAP_POLL_INTERVAL_SECONDS=5
ZAP_POLL_MAX_ERRORS=12

# Replay validation
REPLAY_TIMEOUT_SECONDS=30
REPLAY_MAX_CONCURRENCY=4

# Security
SECRET_KEY=your-secret-key-here

# Logging
LOG_LEVEL=INFO
